{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "transforms": [
        {
          "type": "response.headers",
          "op": "delete",
          "target": {
            "key": "x-matched-path"
          }
        }
      ],
      "continue": true
    }
  ]
}
