NEXT_PUBLIC_API_URL=

# Optional distributed rate limiting for production/serverless deployments.
# When configured, all API instances share the same sliding-window counters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional namespace when a Redis database is shared with other services.
IROGUIDE_RATE_LIMIT_PREFIX=iroguide:rate-limit

# Vercel automatically supplies a protected client identity. For another
# production reverse proxy, explicitly opt in only after it strips caller input.
IROGUIDE_TRUST_PROXY=0
IROGUIDE_TRUSTED_PROXY_HEADER=x-real-ip

# Production launch profile. Keep `free` until every full-mode prerequisite is approved and verified.
# `free` disables AI critique, source-image cloud storage, and bug-report email.
IROGUIDE_LAUNCH_PROFILE=free

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional privacy-aware product analytics.
# Page views and user events load only after the user accepts site data.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# First-party, consent-aware product evidence. `noop` is the safe default.
# Before selecting `firestore`, approve the privacy terms and set a unique
# 32+ character HMAC secret. Sampling accepts a value from 0 through 1.
IROGUIDE_PRODUCT_EVIDENCE_MODE=noop
IROGUIDE_PRODUCT_EVIDENCE_HMAC_SECRET=
IROGUIDE_PRODUCT_EVIDENCE_SAMPLE_RATE=1

# Server-side account storage and token verification.
# Use FIREBASE_ADMIN_SERVICE_ACCOUNT_BASE64, FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON,
# or the three split values below.
FIREBASE_ADMIN_SERVICE_ACCOUNT_BASE64=
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_STORAGE_BUCKET=

# Comma-separated Firebase UIDs approved to use the paid review provider.
# A verified email is also required. Signed custom claim alternative:
# iroguide_review_entitled=true
IROGUIDE_REVIEW_ENTITLED_UIDS=

# Optional private admin tools.
# Comma-separate verified Firebase auth emails or UIDs that can view private
# operator surfaces such as /admin/bug-reports and /admin/insights.
IROGUIDE_ADMIN_EMAILS=
IROGUIDE_ADMIN_UIDS=

# Review provider. This is used only when the launch profile enables AI critique.
IROGUIDE_REVIEW_PROVIDER=auto
# Custom endpoint mode is disabled in production. In local development, every
# endpoint hostname must also appear in this comma-separated allowlist.
IROGUIDE_VISION_REVIEW_ENDPOINT=
IROGUIDE_VISION_REVIEW_ALLOWED_HOSTS=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.5-vl
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_SITE_URL=https://iroguide.com
OPENROUTER_APP_NAME=IroGuide

# Optional developer notification email for contact bug reports.
# Bug reports are stored in Firestore even when email delivery is not configured.
RESEND_API_KEY=
BUG_REPORT_TO_EMAIL=
BUG_REPORT_FROM_EMAIL=
