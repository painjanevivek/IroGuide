{
  "name": "iroguide-frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:free": "playwright test --config playwright.free.config.ts",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "test:rules": "firebase emulators:exec --project demo-iroguide-rules --only firestore,storage \"vitest run --config vitest.rules.config.mts\"",
    "dast:prelaunch": "node scripts/prelaunch-dast.mjs",
    "security:workflow-pins": "node scripts/verify-github-actions-pins.mjs",
    "security:secret-hygiene": "node scripts/verify-repository-secret-hygiene.mjs",
    "billing:gate": "node scripts/verify-billing-gate.mjs",
    "smoke:security": "node scripts/prelaunch-dast.mjs",
    "eval:reviews:validate": "node scripts/validate-review-evals.mjs",
    "eval:reviews:unit": "vitest run src/domain/critique-rubrics.test.ts src/domain/review-evaluation-metrics.test.ts src/server/review-evaluation.test.ts",
    "eval:provider:artifacts": "node scripts/provider-evaluation-runner.mjs",
    "check": "npm run security:secret-hygiene && npm run security:workflow-pins && npm run billing:gate && npm run eval:reviews:validate && npm run typecheck && npm run lint && npm test && npm run test:rules && npm run build",
    "smoke:production": "node scripts/production-smoke.mjs",
    "smoke:account-journey": "node scripts/staging-account-journey.mjs",
    "smoke:admin-readiness": "node scripts/privileged-readiness-smoke.mjs",
    "smoke:storage-boundary": "node scripts/storage-boundary-smoke.mjs",
    "smoke:staging-runtime": "node scripts/staging-runtime-proof.mjs",
    "perf:budget": "node scripts/performance-budget.mjs",
    "probe:operations": "node scripts/operational-synthetic-probe.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@opentelemetry/api": "^1.9.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.1.0",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.2",
    "firebase-tools": "^15.22.2",
    "typescript": "6.0.3",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@opentelemetry/core": "2.8.0",
    "postcss": "8.5.26",
    "uuid": "14.0.1"
  }
}
