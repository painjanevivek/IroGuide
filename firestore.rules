rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function accountAccessAllowed() {
      return signedIn()
        && !exists(/databases/$(database)/documents/reviewDeletionLocks/$(request.auth.uid));
    }

    function ownsExistingDocument() {
      return accountAccessAllowed() && resource.data.userId == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return accountAccessAllowed() && request.resource.data.userId == request.auth.uid;
    }

    function communityEnabled() {
      // Community remains an explicit launch gate. Rules are deployed closed;
      // activation requires a reviewed rules change, not a client-side flag.
      return false;
    }

    function ownsReview(reviewId) {
      return accountAccessAllowed()
        && get(/databases/$(database)/documents/reviews/$(reviewId)).data.userId == request.auth.uid;
    }

    function isReviewCategory(value) {
      return value in ["logo", "poster", "social", "ui", "website", "book-cover", "packaging", "other"];
    }

    function isFeedbackMode(value) {
      return value in ["friendly", "mentor", "direct"];
    }

    function isBoundedDate(value) {
      return value is timestamp || (value is string && value.size() <= 64);
    }

    function hasValidDraftBrief(data) {
      return data is map
        && data.keys().hasAll(["audience", "purpose", "style", "goal", "concern"])
        && data.keys().hasOnly(["audience", "purpose", "style", "goal", "concern"])
        && data.audience is string && data.audience.size() <= 300
        && data.purpose is string && data.purpose.size() <= 500
        && data.style is string && data.style.size() <= 200
        && data.goal is string && data.goal.size() <= 500
        && data.concern is string && data.concern.size() <= 500;
    }

    function hasValidDraftFile(data) {
      return !("file" in data) || (
        data.file is map
        && data.file.keys().hasAll(["name", "type", "size"])
        && data.file.keys().hasOnly(["name", "type", "size"])
        && data.file.name is string && data.file.name.size() > 0 && data.file.name.size() <= 180
        && data.file.type in ["image/jpeg", "image/png", "image/webp"]
        && data.file.size is int && data.file.size > 0 && data.file.size <= 4 * 1024 * 1024
      );
    }

    function isValidActiveDraft(data) {
      return data.keys().hasAll(["userId", "origin", "status", "step", "category", "mode", "brief", "updatedAt"])
        && data.keys().hasOnly(["userId", "origin", "status", "step", "category", "mode", "file", "brief", "createdAt", "updatedAt"])
        && data.origin == "draft"
        && data.status == "draft"
        && data.step in [1, 2, 3, 4]
        && isReviewCategory(data.category)
        && isFeedbackMode(data.mode)
        && hasValidDraftFile(data)
        && hasValidDraftBrief(data.brief)
        && (!("createdAt" in data) || isBoundedDate(data.createdAt))
        && isBoundedDate(data.updatedAt);
    }

    match /users/{userId} {
      allow read: if accountAccessAllowed() && request.auth.uid == userId;
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if ownsExistingDocument();
      allow write: if false;

      match /messages/{messageId} {
        allow read: if ownsReview(reviewId);
        allow write: if false;
      }
    }

    match /reviewDrafts/{draftId} {
      allow read: if ownsExistingDocument();
      allow create: if draftId == request.auth.uid + "_active"
        && ownsIncomingDocument()
        && isValidActiveDraft(request.resource.data);
      allow update: if draftId == request.auth.uid + "_active"
        && ownsExistingDocument()
        && ownsIncomingDocument()
        && isValidActiveDraft(request.resource.data);
      allow delete: if draftId == request.auth.uid + "_active" && ownsExistingDocument();
    }

    match /communityPosts/{postId} {
      allow read: if communityEnabled() && signedIn() && resource.data.visibility == "public";
      allow create, update, delete: if false;

      match /comments/{commentId} {
        allow read: if communityEnabled() && signedIn()
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.visibility == "public";
        allow write: if false;
      }

      match /interactions/{userId} {
        allow read: if communityEnabled() && signedIn()
          && userId == request.auth.uid
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.visibility == "public";
        allow write: if false;
      }
    }

    // Community v1 is server-mediated. Public projections are still returned by
    // the authenticated API so block filtering, consent state, abuse controls,
    // and the kill switch cannot be bypassed with a Firebase client query.
    match /communityProjections/{document=**} { allow read, write: if false; }
    match /communityConsents/{document=**} { allow read, write: if false; }
    match /communityComments/{document=**} { allow read, write: if false; }
    match /communityInteractions/{document=**} { allow read, write: if false; }
    match /communityReports/{document=**} { allow read, write: if false; }
    match /communityBlocks/{document=**} { allow read, write: if false; }
    match /communityModerationActions/{document=**} { allow read, write: if false; }
    match /communityAccountModeration/{document=**} { allow read, write: if false; }
    match /communityAppeals/{document=**} { allow read, write: if false; }
    match /communityAudit/{document=**} { allow read, write: if false; }
    match /communityOutbox/{document=**} { allow read, write: if false; }
    match /communityCounterShards/{document=**} { allow read, write: if false; }
    match /communityNotifications/{document=**} { allow read, write: if false; }

    match /uploads/{uploadId} {
      allow read: if ownsExistingDocument();
      allow write: if false;
    }

    match /productEvidenceEvents/{eventId} {
      allow read, write: if false;
    }

    match /researchFeedback/{responseId} {
      allow read, write: if false;
    }

    // Guided learning is server-owned so clients cannot bypass validation,
    // optimistic concurrency, deletion locks, program gates, or rate limits.
    match /accountExperiences/{document=**} { allow read, write: if false; }
    match /sampleCritiqueProgress/{document=**} { allow read, write: if false; }
    match /selfReviewSessions/{document=**} { allow read, write: if false; }
    match /designBriefDrafts/{document=**} { allow read, write: if false; }
    match /reviewAccessInterests/{document=**} { allow read, write: if false; }
    match /reviewAccessDecisionAudit/{document=**} { allow read, write: if false; }

    match /reviewUploadSessions/{sessionId} {
      allow read, write: if false;
    }

    match /reviewDeletionLocks/{userId} {
      allow read, write: if false;
    }

    match /reviewJobs/{jobId} {
      allow read, write: if false;
    }

    match /reviewJobOutbox/{eventId} {
      allow read, write: if false;
    }

    match /providerUsageReservations/{reservationId} {
      allow read, write: if false;
    }

    match /providerUsageAggregates/{aggregateId} {
      allow read, write: if false;
    }
  }
}
