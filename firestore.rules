rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExistingDocument() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsIncomingDocument() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function isPublicCommunityPost() {
      return resource.data.visibility == "public";
    }

    function ownsReview(reviewId) {
      return signedIn()
        && get(/databases/$(database)/documents/reviews/$(reviewId)).data.userId == request.auth.uid;
    }

    function isReviewCategory(value) {
      return value in ["logo", "poster", "social", "ui", "website", "book-cover", "packaging", "other"];
    }

    function isFeedbackMode(value) {
      return value in ["friendly", "mentor", "direct"];
    }

    function isBoundedDate(value) {
      return value is timestamp || (value is string && value.size() <= 64);
    }

    function hasValidDraftBrief(data) {
      return data is map
        && data.keys().hasAll(["audience", "purpose", "style", "goal", "concern"])
        && data.keys().hasOnly(["audience", "purpose", "style", "goal", "concern"])
        && data.audience is string && data.audience.size() <= 300
        && data.purpose is string && data.purpose.size() <= 500
        && data.style is string && data.style.size() <= 200
        && data.goal is string && data.goal.size() <= 500
        && data.concern is string && data.concern.size() <= 500;
    }

    function hasValidDraftFile(data) {
      return !("file" in data) || (
        data.file is map
        && data.file.keys().hasAll(["name", "type", "size"])
        && data.file.keys().hasOnly(["name", "type", "size"])
        && data.file.name is string && data.file.name.size() > 0 && data.file.name.size() <= 180
        && data.file.type in ["image/jpeg", "image/png", "image/webp"]
        && data.file.size is int && data.file.size > 0 && data.file.size <= 10 * 1024 * 1024
      );
    }

    function isValidActiveDraft(data) {
      return data.keys().hasAll(["userId", "origin", "status", "step", "category", "mode", "brief", "updatedAt"])
        && data.keys().hasOnly(["userId", "origin", "status", "step", "category", "mode", "file", "brief", "createdAt", "updatedAt"])
        && data.origin == "draft"
        && data.status == "draft"
        && data.step in [1, 2, 3, 4]
        && isReviewCategory(data.category)
        && isFeedbackMode(data.mode)
        && hasValidDraftFile(data)
        && hasValidDraftBrief(data.brief)
        && (!("createdAt" in data) || isBoundedDate(data.createdAt))
        && isBoundedDate(data.updatedAt);
    }

    function hasValidImportedReview(data) {
      return data is map
        && data.keys().hasAll(["id", "createdAt", "overallScore", "summary", "strengths", "scores", "rubricVersion", "issues", "annotations", "checklist", "followUps", "provider"])
        && data.keys().hasOnly(["id", "createdAt", "overallScore", "summary", "strengths", "scores", "rubricVersion", "issues", "annotations", "checklist", "followUps", "provider"])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 320
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.overallScore is number && data.overallScore >= 0 && data.overallScore <= 10
        && data.summary is string && data.summary.size() <= 4000
        && data.strengths is list && data.strengths.size() > 0 && data.strengths.size() <= 20
        && data.scores is list && data.scores.size() <= 20
        && data.rubricVersion is string && data.rubricVersion.size() > 0 && data.rubricVersion.size() <= 80
        && data.issues is list && data.issues.size() > 0 && data.issues.size() <= 50
        && data.annotations is list && data.annotations.size() <= 50
        && data.checklist is list && data.checklist.size() <= 50
        && data.followUps is list && data.followUps.size() <= 20
        && data.provider == "demo";
    }

    function isValidImportedReview(data) {
      return data.keys().hasAll(["id", "userId", "origin", "status", "review", "category", "categoryLabel", "savedAt", "updatedAt", "syncState"])
        && data.keys().hasOnly(["id", "userId", "origin", "status", "review", "category", "categoryLabel", "savedAt", "updatedAt", "syncState"])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 700
        && data.origin == "imported"
        && data.status == "imported"
        && isReviewCategory(data.category)
        && data.categoryLabel is string && data.categoryLabel.size() > 0 && data.categoryLabel.size() <= 80
        && isBoundedDate(data.savedAt)
        && isBoundedDate(data.updatedAt)
        && data.syncState in ["local", "cloud"]
        && hasValidImportedReview(data.review);
    }

    function isValidReviewDraft(data) {
      return data is map
        && data.userId == request.auth.uid
        && (isValidActiveDraft(data) || isValidImportedReview(data));
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /reviews/{reviewId} {
      allow read: if ownsExistingDocument();
      allow write: if false;

      match /messages/{messageId} {
        allow read: if ownsReview(reviewId);
        allow write: if false;
      }
    }

    match /reviewDrafts/{draftId} {
      allow read: if ownsExistingDocument();
      allow create: if ownsIncomingDocument() && isValidReviewDraft(request.resource.data);
      allow update: if ownsExistingDocument() && ownsIncomingDocument() && isValidReviewDraft(request.resource.data);
      allow delete: if ownsExistingDocument();
    }

    match /communityPosts/{postId} {
      allow read: if signedIn() && isPublicCommunityPost();
      allow create, update, delete: if false;

      match /comments/{commentId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.visibility == "public";
        allow write: if false;
      }

      match /interactions/{userId} {
        allow read: if signedIn()
          && userId == request.auth.uid
          && get(/databases/$(database)/documents/communityPosts/$(postId)).data.visibility == "public";
        allow write: if false;
      }
    }

    match /uploads/{uploadId} {
      allow read: if ownsExistingDocument();
      allow write: if false;
    }
  }
}
