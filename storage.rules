rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function accountAccessAllowed() {
      return signedIn()
        && !firestore.exists(/databases/(default)/documents/reviewDeletionLocks/$(request.auth.uid));
    }

    function ownsUserPath(userId) {
      return accountAccessAllowed() && request.auth.uid == userId;
    }

    match /users/{userId}/reviews/{reviewId}/source.png {
      allow read: if ownsUserPath(userId);
      allow write: if false;
    }

    match /users/{userId}/reviews/{reviewId}/source.jpg {
      allow read: if ownsUserPath(userId);
      allow write: if false;
    }

    match /users/{userId}/reviews/{reviewId}/source.webp {
      allow read: if ownsUserPath(userId);
      allow write: if false;
    }

    match /users/{userId}/review-uploads/{uploadId}/source {
      // The server issues a short-lived GCS V4 signed URL after authorization.
      // Firebase client SDK access remains denied before and after that write.
      allow read, write: if false;
    }
  }
}
